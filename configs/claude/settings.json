{
  "syncClaudeAiSkills": false,
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "clickup@synced": false,
    "cc-plugin-tips@builtin": false,
    "cc-plugin-diff@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "mods-guide@builtin": false,
    "you-should-know@builtin": false,
    "cc-plugin-claude-test@builtin": false,
    "cc-plugin-agents-md@builtin": false,
    "cc-plugin-telemetry@builtin": false,
    "cc-plugin-sec-default@builtin": false
  },
  "extraKnownMarketplaces": {
    "procuro-tools": {
      "source": {
        "source": "github",
        "repo": "Procuro-Inc/pdp-claude-plugins"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "editorMode": "vim"
}
